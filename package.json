{
  "name": "emulateur-gp39",
  "version": "1.0.0",
  "private": true,
  "description": "Émulateur PWA (Vue 3 / Quasar) de l'écran d'un traceur GPS compatible GP-39 : affiche un fichier GPX de waypoints comme le matériel.",
  "keywords": [
    "gp39",
    "gps",
    "gpx",
    "pwa",
    "quasar",
    "vue"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Vincent Aizier",
  "repository": {
    "type": "git",
    "url": "https://github.com/lebonwinch/emulateur_furuno_gp39.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "test": "vitest run",
    "notices": "node scripts/notices.mjs",
    "dev:pwa": "quasar dev -m pwa",
    "build:pwa": "quasar build -m pwa"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@quasar/extras": "^2.1.0",
    "geomagnetism": "^0.2.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.2",
    "quasar": "^2.35.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Émulateur compatible GP-39"
}
